<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EscPosEmulator.Models;assembly=EscPosEmulator"
        xmlns:vm="clr-namespace:EscPosEmulator.ViewModels;assembly=EscPosEmulator"
        x:Class="EscPosEmulator.Views.PrintingPreferencesWindow"
        x:DataType="vm:PrintingPreferencesViewModel"
        Title="XP-80C — Printing Preferences"
        Width="560" Height="560"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="#1E1E1E">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- header: device name + paper (app palette) -->
    <Border Grid.Row="0" Background="#111111" BorderBrush="#333" BorderThickness="0,0,0,1">
      <StackPanel Margin="16,12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="XP-80C" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0"
                     VerticalAlignment="Center"/>
          <Border Background="#2D5A27" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Text="print settings" FontSize="10" FontWeight="SemiBold" Foreground="#A5D6A7"/>
          </Border>
        </StackPanel>
        <TextBlock Margin="0,2,0,0" Text="{Binding PaperLabel}" FontSize="12" Foreground="#888"/>
      </StackPanel>
    </Border>

    <!-- tab page content -->
    <TabControl Grid.Row="1" Margin="12,10,12,4" Background="Transparent" SelectedIndex="0">

      <!-- ──────────────── LAYOUT ──────────────── -->
      <TabItem Header="Layout">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="4,8,4,12">

            <Border Background="#2D2D30" CornerRadius="8" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="PRINT ORDER" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"
                           LetterSpacing="1"/>
                <RadioButton GroupName="PrintOrder" IsChecked="{Binding PrintOrderIsFrontToBack}"
                             Content="Front to back" FontSize="13"/>
                <RadioButton GroupName="PrintOrder" IsChecked="{Binding PrintOrderIsRightThenDown}"
                             Content="Right, then down" Margin="20,0,0,0" FontSize="13"/>
              </StackPanel>
            </Border>

            <Border Background="#2D2D30" CornerRadius="8" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="DOCUMENT APPEARANCE" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"
                           LetterSpacing="1"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBox Text="{Binding PageScale, StringFormat='{}{0:0.##}'}"
                           Width="64" FontSize="13" HorizontalAlignment="Left"/>
                  <TextBlock Text="×  page scale" VerticalAlignment="Center" FontSize="13" Foreground="#CCC"/>
                  <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#666">
                    0.5 – 4.0
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBox Text="{Binding LineSpacing, StringFormat='{}{0}'}"
                           Width="64" FontSize="13" HorizontalAlignment="Left"/>
                  <TextBlock Text="line height (0 = follow the printer stream)"
                             VerticalAlignment="Center" FontSize="13" Foreground="#CCC"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#2D2D30" CornerRadius="8" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="PAPER" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"
                           LetterSpacing="1"/>
                <CheckBox Content="Draw paper edges and border"
                          IsChecked="{Binding DrawBorders}" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Top margin:" VerticalAlignment="Center" FontSize="13" Foreground="#CCC"/>
                  <TextBox Text="{Binding MarginTop, StringFormat='{}{0}'}" Width="64" FontSize="13"
                           HorizontalAlignment="Left"/>
                  <TextBlock Text="dots" VerticalAlignment="Center" FontSize="13" Foreground="#CCC"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Left margin:" VerticalAlignment="Center" FontSize="13" Foreground="#CCC"/>
                  <TextBox Text="{Binding MarginLeft, StringFormat='{}{0}'}" Width="64" FontSize="13"
                           HorizontalAlignment="Left"/>
                  <TextBlock Text="dots" VerticalAlignment="Center" FontSize="13" Foreground="#CCC"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ──────────────── PAPER QUALITY ──────────────── -->
      <TabItem Header="Paper-Quality">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="4,8,4,12">

            <Border Background="#2D2D30" CornerRadius="8" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="COPY" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"
                           LetterSpacing="1"/>
                <TextBox Text="{Binding Copies, StringFormat='{}{0}'}" Width="100" FontSize="13"
                         HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <Border Background="#2D2D30" CornerRadius="8" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="HALFTONING" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"
                           LetterSpacing="1"/>
                <ComboBox ItemsSource="{Binding HalftoningOptions}"
                          SelectedItem="{Binding Halftoning}"
                          Width="220" HorizontalAlignment="Left" FontSize="13"/>
                <TextBlock Text="{Binding HalftoningCaption}" FontSize="11" Foreground="#888"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                           Text="Halftoning applies dithering to raster graphics (GS v bands and GDI prints) so 1-bit images keep shading instead of clipping."/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ──────────────── ADVANCED ──────────────── -->
      <TabItem Header="Advanced">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="4,8,4,12">

            <Border Background="#2D2D30" CornerRadius="8" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="DOCUMENT" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"
                           LetterSpacing="1"/>
                <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                  <ListBox ItemsSource="{Binding AdvancedRows}" Background="Transparent" BorderThickness="0"
                           SelectionMode="Single" MinHeight="60" Padding="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:PropertyValue">
                        <ListBoxItem Padding="0,0,0,0" Background="Transparent">
                          <Grid ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="10,6" FontSize="12"
                                       Foreground="#CCC"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="6,6,10,6" FontSize="12"
                                       Foreground="#9CDCFE"/>
                          </Grid>
                        </ListBoxItem>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
                <Button Content="Properties…" HorizontalAlignment="Left" Padding="16,5" FontSize="13"
                        Background="#3E3E42" Foreground="#CCC" CornerRadius="4"
                        Command="{Binding OpenAdvancedPropertiesCommand}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                           Text="Advanced Document Settings control how the emulated paper is rendered. These settings are preview-only and are not part of the ESC/POS protocol."/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- OK / Cancel / Apply -->
    <Border Grid.Row="2" Background="#111111" BorderBrush="#333" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="12,8">
        <Button Content="OK" Width="88" IsDefault="True" Command="{Binding OkCommand}"
                Background="#0E639C" Foreground="White" Padding="0,6" CornerRadius="4"/>
        <Button Content="Cancel" Width="88" IsCancel="True" Command="{Binding CancelCommand}"
                Background="#3E3E42" Foreground="#CCC" Padding="0,6" CornerRadius="4"/>
        <Button Content="Apply" Width="88" Command="{Binding OkCommand}"
                Background="#3E3E42" Foreground="#CCC" Padding="0,6" CornerRadius="4"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
