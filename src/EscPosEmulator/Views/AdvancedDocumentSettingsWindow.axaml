<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EscPosEmulator.ViewModels;assembly=EscPosEmulator"
        xmlns:models="clr-namespace:EscPosEmulator.Models;assembly=EscPosEmulator"
        x:Class="EscPosEmulator.Views.AdvancedDocumentSettingsWindow"
        x:DataType="vm:AdvancedDocumentSettingsViewModel"
        Title="Advanced Document Settings — Properties"
        Width="540" Height="420"
        MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="#1E1E1E">

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Background" Value="#3E3E42"/>
      <Setter Property="Foreground" Value="#DDD"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#0E639C"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── title ──────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="36" Height="36" CornerRadius="8" Background="#2D2D30"
                VerticalAlignment="Center">
          <TextBlock Text="⚙" FontSize="16" Foreground="#4EC9B0"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding PrinterName}" Foreground="#F0F0F0" FontSize="15"
                     FontWeight="SemiBold"/>
          <TextBlock Text="Advanced Document Settings" FontSize="11" Foreground="#888"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── properties grid ────────────────────────────────────── -->
    <Border Grid.Row="1" Margin="14" Background="#1E1E1E" BorderBrush="#333"
            BorderThickness="1" CornerRadius="6">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="190,*" Margin="12,8,12,7">
          <TextBlock Grid.Column="0" Text="PROPERTY" FontSize="10" FontWeight="SemiBold"
                     Foreground="#666"/>
          <TextBlock Grid.Column="1" Text="VALUE" FontSize="10" FontWeight="SemiBold"
                     Foreground="#666"/>
        </Grid>
        <Rectangle Grid.Row="0" Height="1" Fill="#333" VerticalAlignment="Bottom"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PropertyValue">
                <Border BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="190,*" MinHeight="32" Margin="12,0">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="0,7,8,7"
                               FontSize="12.5" Foreground="#AAA" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="0,7,0,7"
                               FontSize="12.5" Foreground="#9CDCFE" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#252528" CornerRadius="0,0,6,6" Padding="12,8">
          <TextBlock Text="Values are managed from Printing Preferences → Layout / Paper-Quality."
                     FontSize="11" Foreground="#777"/>
        </Border>
      </Grid>
    </Border>

    <!-- ── footer ─────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,10">
        <Button Classes="accent" Content="OK" Width="88" IsDefault="True" Click="OnAccept"/>
        <Button Content="Cancel" Width="88" IsCancel="True" Click="OnCancel"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
