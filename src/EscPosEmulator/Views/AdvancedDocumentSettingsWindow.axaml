<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EscPosEmulator.ViewModels;assembly=EscPosEmulator"
        xmlns:models="clr-namespace:EscPosEmulator.Models;assembly=EscPosEmulator"
        x:Class="EscPosEmulator.Views.AdvancedDocumentSettingsWindow"
        x:DataType="vm:AdvancedDocumentSettingsViewModel"
        Title="Advanced Document Settings — Properties"
        Width="520" Height="400"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="#F0F0F0"
        CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- title bar inside the client area, Windows properties style -->
    <Border Grid.Row="0" Background="#0078D7" Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="18" Height="18" CornerRadius="3" Background="#33FFFFFF"/>
        <TextBlock Text="{Binding PrinterName}" Foreground="White" FontSize="14"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- properties grid -->
    <Border Grid.Row="1" Margin="12" Background="White" BorderBrush="#C0C0C0" BorderThickness="1">
      <ListBox ItemsSource="{Binding Rows}" Background="White" BorderThickness="0"
               SelectionMode="Single" Padding="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:PropertyValue">
            <ListBoxItem Padding="0,0,0,0" Foreground="#111">
              <Grid ColumnDefinitions="180,*" RowDefinitions="*,Auto" MinHeight="34">
                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="12,8,8,8" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="4,8,12,8" FontSize="13"
                           Foreground="#222" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Rectangle Grid.ColumnSpan="2" Grid.Row="1" Height="1" Fill="#ECECEC"/>
              </Grid>
            </ListBoxItem>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- footer -->
    <Border Grid.Row="2" Background="#E1E1E1" BorderBrush="#C0C0C0" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,10">
        <Button Content="Properties…" HorizontalAlignment="Left" Padding="18,5" FontSize="13"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="OK" Width="88" IsDefault="True" Click="OnAccept"/>
          <Button Content="Cancel" Width="88" IsCancel="True"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
