<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EscPosEmulator.ViewModels;assembly=EscPosEmulator"
        xmlns:models="clr-namespace:EscPosEmulator.Models;assembly=EscPosEmulator"
        x:Class="EscPosEmulator.Views.AdvancedDocumentSettingsWindow"
        x:DataType="vm:AdvancedDocumentSettingsViewModel"
        Title="Advanced Document Settings — Properties"
        Width="520" Height="400"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="#1E1E1E"
        CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- title bar inside the client area, app palette -->
    <Border Grid.Row="0" Background="#111111" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="14,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="20" Height="20" CornerRadius="4" Background="#2D5A27">
          <TextBlock Text="⚙" FontSize="11" Foreground="#A5D6A7"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding PrinterName}" Foreground="#E0E0E0" FontSize="14"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- properties grid -->
    <Border Grid.Row="1" Margin="12" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1"
            CornerRadius="6">
      <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
               SelectionMode="Single" Padding="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:PropertyValue">
            <ListBoxItem Padding="0,0,0,0" Background="Transparent">
              <Grid ColumnDefinitions="180,*" RowDefinitions="*,Auto" MinHeight="34">
                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="12,8,8,8" FontSize="13"
                           Foreground="#CCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="4,8,12,8" FontSize="13"
                           Foreground="#9CDCFE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Rectangle Grid.ColumnSpan="2" Grid.Row="1" Height="1" Fill="#2D2D30"/>
              </Grid>
            </ListBoxItem>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- footer -->
    <Border Grid.Row="2" Background="#111111" BorderBrush="#333" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,8">
        <Button Content="Properties…" HorizontalAlignment="Left" Padding="18,5" FontSize="13"
                Background="#3E3E42" Foreground="#CCC" CornerRadius="4"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="OK" Width="88" IsDefault="True" Click="OnAccept"
                  Background="#0E639C" Foreground="White" Padding="0,6" CornerRadius="4"/>
          <Button Content="Cancel" Width="88" IsCancel="True"
                  Background="#3E3E42" Foreground="#CCC" Padding="0,6" CornerRadius="4"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
